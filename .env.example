# Supabase Configuration
# The Supabase project URL and keys for the database client.
SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Keep private, never expose to frontend)
# Used by the scheduler to bypass Row-Level Security (RLS) for reports & snapshots.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Zenacle CRM Integration
# Endpoint URL and Authorization secret token for forwarding daily reports.
CRM_INTEGRATION_URL=http://localhost:3000/api/integrations/zenacle-home
CRM_INTEGRATION_SECRET=your-crm-integration-secret
